# ==============================================================================
# CESIUM ENVIRONMENT CONFIGURATION (Phase 1)
# ==============================================================================
# Copy this file to .env or .env.local for local development.
# NEVER commit .env or .env.local to version control (protected by .gitignore).
# NEVER expose SUPABASE_SERVICE_ROLE_KEY or database passwords here.
#
# Option A: Hosted Supabase Project
# Retrieve from: Supabase Dashboard -> Project Settings -> API
# VITE_SUPABASE_URL=https://<your-project-id>.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
#
# Option B: Local Supabase CLI
# Generated by: npx supabase start
# VITE_SUPABASE_URL=http://127.0.0.1:54321
# VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM0MTI4MDB9.dummy-local-anon-key-here
# ==============================================================================

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Cloudflare R2 Zero-Egress Storage (Optional for local dev, recommended for production media)
# R2_ACCOUNT_ID=your-cloudflare-account-id
# R2_ACCESS_KEY_ID=your-r2-access-key-id
# R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
# R2_BUCKET_NAME=cesium-media
# R2_PUBLIC_URL=https://pub-your-hash.r2.dev

# Google Gemini Synthetic Intelligence (Auride AI Companion)
# Get your API key from Google AI Studio: https://aistudio.google.com/app/apikey
# GEMINI_API_KEY=AIzaSy...
# GEMINI_MODEL=gemini-2.5-flash

